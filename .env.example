# Hugging Face access token, needed for the pyannote diarization model used by WhisperX.
HF_TOKEN=

# WhisperX device/compute settings (Mac default: CPU, int8; use "cuda"/"float16" on GPU boxes)
WHISPERX_DEVICE=cpu
WHISPERX_COMPUTE_TYPE=int8

# WhisperX model + transcription settings
WHISPERX_MODEL=small
WHISPERX_BATCH_SIZE=16
WHISPERX_LANGUAGE=en

# Diarization speaker-count hints, passed to pyannote's DiarizationPipeline. Leave all
# unset to let it auto-detect the speaker count. If you know the exact number of speakers
# in the video, set WHISPERX_NUM_SPEAKERS alone — it's a stronger constraint than a
# min/max range and takes precedence when set. Otherwise use MIN/MAX to bound a range.
WHISPERX_NUM_SPEAKERS=
WHISPERX_MIN_SPEAKERS=
WHISPERX_MAX_SPEAKERS=

# Frame captioning settings (requires a local Ollama install running in the background).
# qwen3-vl-instruct-16k is the non-thinking instruct variant behind a Modelfile alias
# (`ollama create qwen3-vl-instruct-16k -f Modelfile.qwen-instruct`). The thinking
# variant (plain qwen3-vl:8b) spends ~2k hidden thinking tokens per caption (~48 s/frame
# vs ~2 s) and at a 16k context deterministically fills the whole window with thinking
# and returns an empty caption - see data/runs/run2_instruct16k/DIAGNOSIS.md in the
# workspace for the evidence.
CAPTION_FPS=1.0
CAPTION_MODEL=qwen3-vl-instruct-16k

# Which adapter the captioning stage talks to the model through: "ollama" (this
# repo's built-in adapter over the ollama SDK) or "fairlib" (the fair_llm
# OllamaAdapter behind the vision contract of fair_llm issue #146; needs the
# vision-capable fair-llm install). Same local daemon and model either way -
# the lever swaps the adapter layer, not what leaves the box.
CAPTION_BACKEND=ollama

# Same lever for the screenplay (Ornith) stage. "fairlib" is capability-gated:
# it is refused with a typed error while the INSTALLED fair-llm predates
# fair_llm #147 (usage telemetry), because the stage's context-overflow
# diagnostic needs the reply's stop reason. The gate flips to construction by
# itself once the installed fair-llm carries #147.
SCREENPLAY_BACKEND=ollama

# Coder stage (python -m src.cli.code_utterances; DATA_MODEL 4.5). Runs on the
# delivered utterance table through a fairlib SimpleAgent. CODER_PROVIDER
# accepts only "ollama" until the PII/egress gate binds a remote provider
# (anthropic/openai/gemini are refused with a typed error naming the gate).
# CODER_ID names the coder in the CSV code columns (<CODE>_<coder_id>).
CODER_MODEL=qwen2.5:14b
CODER_PROVIDER=ollama
CODER_ID=fairlib_local
# Prior utterances shown as context for each target; retries the framework
# validator allows before a typed CoderError; agent step budget per utterance.
CODER_CONTEXT_UTTERANCES=5
CODER_MAX_RETRIES=2
CODER_MAX_STEPS=3
#CODER_NUM_CTX=
# Output budget for one coding reply. Neutral name; on Ollama it becomes
# num_predict at adapter construction. Leave unset for the model default.
# A too-small value makes a thinking model return an empty MAX_TOKENS reply,
# which today surfaces as a coding failure rather than a budget one.
#CODER_MAX_TOKENS=

# How many previous captions to feed back into the prompt as context when captioning
# each new frame (most recent last). Set to "all" to feed back every prior caption
# instead of a fixed window.
CAPTION_CONTEXT_CAPTIONS=1

# Every sampled frame is downscaled (long edge to this many px, never upscaled) and
# JPEG-encoded before being sent to the captioning model. Qwen3-VL's vision-token cost
# scales with pixel count, and a source video's native resolution (1080p/2K/etc.) is
# well past the point of diminishing returns for reading gaze/body language, so this
# is a direct latency lever independent of CAPTION_CONTEXT_CAPTIONS above. Set to
# "none" to send frames at native resolution (slower, only matters if you need to read
# very fine detail on small/distant subjects).
CAPTION_MAX_DIMENSION=1280

# Offset (seconds) after each utterance's start time to grab a "reaction shot" frame,
# captioned the same way as the fixed-interval frames above and merged into the same
# timeline (tagged "trigger": "speech_start" to distinguish it from "fixed_interval").
SPEECH_FRAME_OFFSET=0.5

# How many sequential frames to caption in a chain per speech-start "reaction shot"
# (spaced SPEECH_BURST_SPACING seconds apart, starting at the offset above), so the
# model has a chance to notice mouth movement / turn-taking and identify which visible
# person is the SPEAKER_NN who just started talking, rather than guessing from a single
# still. Each extra frame is a full additional local Ollama call for that utterance, so
# this trades speech-start captioning latency for speaker-identification reliability.
# Set to 1 to disable bursting (one call per utterance, the original behavior).
SPEECH_BURST_FRAMES=2
SPEECH_BURST_SPACING=0.2

# Per-utterance tone/emotion classification (src/cli/classify_tone.py), via emotion2vec+
# (loaded through funasr, not Ollama-servable — but unlike the Omni stage above, this one
# is small and CPU-friendly, no GPU required).
TONE_MODEL=iic/emotion2vec_plus_large

# Orchestrator/screenwriter model (requires a local Ollama install running in the
# background). Ornith is not on the public Ollama registry, so it must already exist
# locally (`ollama list`) — it cannot be auto-pulled like Qwen3-VL.
ORNITH_MODEL=ornith-1.5-255k

# Optional context-size override for the Ornith call (also pinnable via
# Modelfile - see Modelfile.ornith). Ornith is a reasoning model: its prompt
# (the full merged timeline) plus its think block must fit, or it hits the
# context limit mid-thinking and the run fails with a typed error. 262144 is
# the model's maximum and the safe default on a >=48 GB GPU box.
ORNITH_NUM_CTX=262144

# Sampling controls sent with every Ollama call and recorded in the run's
# provenance. Deterministic by default; only override deliberately.
#SAMPLING_TEMPERATURE=0.0
#SAMPLING_SEED=
