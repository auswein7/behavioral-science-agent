.env

__pycache__/
*.py[cod]

.DS_Store

data/raw_videos/

.venv/
data/runs/
data/deliverables/

# Generated pipeline outputs are Tier A/B (PII-bearing) and never committed;
# .gitkeep placeholders stay tracked. Hand-written manifests (data/manifests/)
# are Tier C metadata and ARE tracked.
data/gate/
# Imported external-study sessions: the speaker map holds the source's own
# (demographic) labels, and the generated manifest is not hand-written.
data/imports/
data/transcripts/*
!data/transcripts/.gitkeep
data/captions/*
!data/captions/.gitkeep
data/screenplays/*
!data/screenplays/.gitkeep
